generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// AUTH & USERS
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified DateTime? @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts    Account[]
  sessions    Session[]
  memberships OrgMembership[]
  exports     Export[]
  controlNotes   ControlNote[]
  auditorComments AuditorComment[]
  ownedTreatments    RiskTreatment[] @relation("TreatmentOwner")
  createdTreatments  RiskTreatment[] @relation("TreatmentCreator")
  assignedGaps       GapAssignment[] @relation("GapAssignee")
  assignedByGaps     GapAssignment[] @relation("GapAssigner")
  createdAuditCycles AuditCycle[]
  assignedRequests   AuditorRequest[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// ORGANIZATIONS
// ============================================

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships          OrgMembership[]
  githubConnection     GitHubConnection?
  repositories         Repository[]
  subscription         Subscription?
  exports              Export[]
  complianceSnapshots  ComplianceSnapshot[]
  apiKeys                 ApiKey[]
  notificationPreferences NotificationPreferences?
  shareableReports        ShareableReport[]
  alerts               ComplianceAlert[]
  controlNotes         ControlNote[]
  evidenceExceptions   EvidenceException[]
  auditorSessions      AuditorSession[]
  auditorComments      AuditorComment[]
  controlSignoffs      ControlSignoff[]
  orgProfile           OrgProfile?
  calcConfig           OrgCalcConfig?
  controlStatusSnapshots ControlStatusSnapshot[]
  remediationEvents      RemediationEvent[]
  evidenceFeedback       EvidenceFeedback[]
  webhookEvents          WebhookEvent[]
  orgMembershipEvents    OrgMembershipEvent[]
  ciArtifacts            CIArtifact[]
  deploymentEnvironments DeploymentEnvironment[]
  riskTreatments         RiskTreatment[]
  gapAssignments         GapAssignment[]
  auditCycles            AuditCycle[]
  auditFindings          AuditFinding[]
  auditorRequests        AuditorRequest[]

  @@map("organizations")
}

model OrgMembership {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  orgId     String   @map("org_id")
  role      String   @default("member")
  createdAt DateTime @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@map("org_memberships")
}

// ============================================
// GITHUB INTEGRATION
// ============================================

model GitHubConnection {
  id                 String    @id @default(cuid())
  orgId              String    @unique @map("org_id")
  githubAccountId    Int       @map("github_account_id")
  githubAccountLogin String    @map("github_account_login")
  githubAccountType  String    @map("github_account_type")
  accessToken        String    @db.Text @map("access_token")
  refreshToken       String?   @db.Text @map("refresh_token")
  tokenExpiresAt     DateTime? @map("token_expires_at")
  scope              String?
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  installationId Int?     @map("installation_id")
  webhookSecret  String?  @db.Text @map("webhook_secret")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("github_connections")
}

model Repository {
  id            String    @id @default(cuid())
  orgId         String    @map("org_id")
  githubRepoId  BigInt    @unique @map("github_repo_id")
  name          String
  fullName      String    @map("full_name")
  defaultBranch String    @default("main") @map("default_branch")
  isPrivate     Boolean   @default(false) @map("is_private")
  isActive      Boolean   @default(true) @map("is_active")
  lastSyncedAt  DateTime? @map("last_synced_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  lastWebhookAt DateTime? @map("last_webhook_at")
  webhookEnabled Boolean  @default(false) @map("webhook_enabled")

  organization           Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  commits                Commit[]
  pullRequests           PullRequest[]
  branchProtections      BranchProtection[]
  ciArtifacts            CIArtifact[]
  deploymentEnvironments DeploymentEnvironment[]

  @@map("repositories")
}

model Commit {
  id                 String   @id @default(cuid())
  repoId             String   @map("repo_id")
  sha                String
  message            String   @db.Text
  authorName         String   @map("author_name")
  authorEmail        String   @map("author_email")
  committedAt        DateTime @map("committed_at")
  url                String?
  verified           Boolean  @default(false)
  verificationReason String?  @map("verification_reason")
  createdAt          DateTime @default(now()) @map("created_at")

  repository Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([repoId, sha])
  @@map("commits")
}

model PullRequest {
  id          String    @id @default(cuid())
  repoId      String    @map("repo_id")
  githubPrId  BigInt    @map("github_pr_id")
  number      Int
  title       String
  body        String?   @db.Text
  state       String
  authorLogin String    @map("author_login")
  baseBranch  String    @map("base_branch")
  headBranch  String    @map("head_branch")
  mergedAt    DateTime? @map("merged_at")
  closedAt    DateTime? @map("closed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  url         String?

  repository Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)
  reviews    Review[]

  @@unique([repoId, githubPrId])
  @@map("pull_requests")
}

model Review {
  id             String   @id @default(cuid())
  prId           String   @map("pr_id")
  githubReviewId BigInt   @map("github_review_id")
  reviewerLogin  String   @map("reviewer_login")
  state          String
  body           String?  @db.Text
  submittedAt    DateTime @map("submitted_at")
  createdAt      DateTime @default(now()) @map("created_at")

  pullRequest PullRequest @relation(fields: [prId], references: [id], onDelete: Cascade)

  @@unique([prId, githubReviewId])
  @@map("reviews")
}

model BranchProtection {
  id                  String   @id @default(cuid())
  repoId              String   @map("repo_id")
  branch              String
  requirePullRequest  Boolean  @default(false) @map("require_pull_request")
  requiredApprovals   Int      @default(0) @map("required_approvals")
  dismissStaleReviews Boolean  @default(false) @map("dismiss_stale_reviews")
  requireCodeOwners   Boolean  @default(false) @map("require_code_owners")
  enforceAdmins       Boolean  @default(false) @map("enforce_admins")
  requireStatusChecks Boolean  @default(false) @map("require_status_checks")
  snapshotAt          DateTime @default(now()) @map("snapshot_at")
  createdAt           DateTime @default(now()) @map("created_at")

  repository Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([repoId, branch, snapshotAt])
  @@map("branch_protections")
}

// ============================================
// COMPLIANCE
// ============================================

model ComplianceFramework {
  id          String   @id @default(cuid())
  name        String   @unique
  version     String?
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  controls ComplianceControl[]

  @@map("compliance_frameworks")
}

model ComplianceControl {
  id           String   @id @default(cuid())
  frameworkId  String   @map("framework_id")
  code         String
  title        String
  description  String?  @db.Text
  evidenceType String   @map("evidence_type")
  createdAt    DateTime @default(now()) @map("created_at")

  framework ComplianceFramework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)

  @@unique([frameworkId, code])
  @@map("compliance_controls")
}

model ComplianceSnapshot {
  id              String   @id @default(cuid())
  orgId           String   @map("org_id")
  snapshotDate    DateTime @map("snapshot_date") @db.Date
  overallScore    Int      @map("overall_score")
  totalControls   Int      @map("total_controls")
  withEvidence    Int      @map("with_evidence")
  partial         Int
  limited         Int      @default(0)
  noEvidence      Int      @map("no_evidence")
  frameworkScores Json?    @map("framework_scores")
  createdAt       DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, snapshotDate])
  @@map("compliance_snapshots")
}

// ============================================
// SUBSCRIPTIONS & EXPORTS
// ============================================

model Subscription {
  id                   String    @id @default(cuid())
  orgId                String    @unique @map("org_id")
  stripeCustomerId     String?   @map("stripe_customer_id")
  stripeSubscriptionId String?   @map("stripe_subscription_id")
  status               String    @default("free")
  plan                 String    @default("free")
  currentPeriodEnd     DateTime? @map("current_period_end")
  cancelAtPeriodEnd    Boolean   @default(false) @map("cancel_at_period_end")
  trialStartedAt            DateTime? @map("trial_started_at")
  trialEndsAt               DateTime? @map("trial_ends_at")
  trialUsed                 Boolean   @default(false) @map("trial_used")
  trialExportsUsed          Int       @default(0) @map("trial_exports_used")
  trialAuditorSessionsUsed  Int       @default(0) @map("trial_auditor_sessions_used")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model OrgCalcConfig {
  id        String   @id @default(cuid())
  orgId     String   @unique @map("org_id")
  config    Json     @default("{}")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("org_calc_configs")
}

model Export {
  id          String   @id @default(cuid())
  orgId       String   @map("org_id")
  userId      String?  @map("user_id")
  type        String
  frameworkId String?  @map("framework_id")
  fileName    String   @map("file_name")
  fileUrl     String?  @map("file_url")
  status      String   @default("pending")
  createdAt   DateTime @default(now()) @map("created_at")
  auditorEmail String? @map("auditor_email")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("exports")
}

// ============================================
// API KEYS
// ============================================

model ApiKey {
  id         String    @id @default(cuid())
  orgId      String    @map("org_id")
  name       String
  keyHash    String    @unique @map("key_hash")
  keyPrefix  String    @map("key_prefix")
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime? @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("api_keys")
}

// ============================================
// NOTIFICATION PREFERENCES
// ============================================

model NotificationPreferences {
  id                  String   @id @default(cuid())
  orgId               String   @unique @map("org_id")
  syncFailures        Boolean  @default(true) @map("sync_failures")
  weeklyDigest        Boolean  @default(true) @map("weekly_digest")
  exportReady         Boolean  @default(true) @map("export_ready")
  subscriptionUpdates Boolean  @default(true) @map("subscription_updates")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model ShareableReport {
  id        String    @id @default(cuid())
  orgId     String    @map("org_id")
  token     String    @unique @default(cuid())
  title     String    @default("Compliance Report")
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("shareable_reports")
}

// ============================================
// COMPLIANCE MONITORING & ALERTS
// ============================================

model ComplianceAlert {
  id          String    @id @default(cuid())
  orgId       String    @map("org_id")
  type        String
  severity    String    @default("medium")
  title       String
  description String    @db.Text
  metadata    Json?
  resolvedAt  DateTime? @map("resolved_at")
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, resolvedAt, createdAt])
  @@map("compliance_alerts")
}

// ============================================
// LOCK-IN FEATURES
// ============================================

model ControlNote {
  id            String   @id @default(cuid())
  orgId         String   @map("org_id")
  controlCode   String   @map("control_code")
  frameworkName String   @map("framework_name")
  content       String   @db.Text
  authorId      String   @map("author_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([orgId, controlCode, frameworkName])
  @@map("control_notes")
}

model EvidenceException {
  id            String    @id @default(cuid())
  orgId         String    @map("org_id")
  controlCode   String    @map("control_code")
  frameworkName String    @map("framework_name")
  reason        String    @db.Text
  expiresAt     DateTime? @map("expires_at")
  createdBy     String    @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, controlCode, frameworkName])
  @@map("evidence_exceptions")
}

// ============================================
// AUDITOR PORTAL
// ============================================

model AuditorSession {
  id              String    @id @default(cuid())
  orgId           String    @map("org_id")
  auditorEmail    String    @map("auditor_email")
  auditorName     String?   @map("auditor_name")
  token           String    @unique
  tokenHash       String?   @unique @map("token_hash")
  frameworkFilter String?   @map("framework_filter")
  expiresAt       DateTime  @map("expires_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  lastActiveAt    DateTime? @map("last_active_at")

  organization Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  comments     AuditorComment[]
  signoffs     ControlSignoff[]

  @@index([orgId])
  @@map("auditor_sessions")
}

model AuditorComment {
  id            String   @id @default(cuid())
  orgId         String   @map("org_id")
  sessionId     String   @map("session_id")
  controlCode   String   @map("control_code")
  frameworkName String   @map("framework_name")
  body          String   @db.Text
  status        String   @default("open")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  session      AuditorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  author       User?          @relation(fields: [resolvedBy], references: [id])
  resolvedBy   String?        @map("resolved_by")

  @@index([orgId, controlCode])
  @@map("auditor_comments")
}

model ControlSignoff {
  id            String   @id @default(cuid())
  orgId         String   @map("org_id")
  sessionId     String   @map("session_id")
  controlCode   String   @map("control_code")
  frameworkName String   @map("framework_name")
  verdict       String
  note          String?  @db.Text
  signedAt      DateTime @default(now()) @map("signed_at")

  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  session      AuditorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, controlCode, frameworkName])
  @@index([orgId, controlCode])
  @@map("control_signoffs")
}

// ============================================
// DATA FLYWHEEL
// ============================================

model OrgProfile {
  id          String   @id @default(cuid())
  orgId       String   @unique @map("org_id")
  industry    String?
  companySize String?  @map("company_size")
  techStack   String[]
  updatedAt   DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("org_profiles")
}

model IndustryBenchmark {
  id          String   @id @default(cuid())
  framework   String
  industry    String?
  companySize String?  @map("company_size")
  controlCode String   @map("control_code")
  passRate    Float    @map("pass_rate")
  avgScore    Float    @map("avg_score")
  p25         Float
  p50         Float
  p75         Float
  sampleCount Int      @map("sample_count")
  computedAt  DateTime @default(now()) @map("computed_at")

  @@unique([framework, industry, companySize, controlCode, computedAt])
  @@index([framework, industry, companySize, computedAt])
  @@map("industry_benchmarks")
}

// ============================================
// SELF-IMPROVING COMPLIANCE INTELLIGENCE
// ============================================

model ControlStatusSnapshot {
  id            String   @id @default(cuid())
  orgId         String   @map("org_id")
  controlCode   String   @map("control_code")
  frameworkName String   @map("framework_name")
  status        String   // "has_evidence" | "partial" | "limited" | "no_evidence"
  evidenceCount Int      @map("evidence_count")
  snapshotDate  DateTime @map("snapshot_date") @db.Date
  createdAt     DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, controlCode, frameworkName, snapshotDate])
  @@index([orgId, snapshotDate])
  @@index([controlCode, frameworkName, snapshotDate])
  @@map("control_status_snapshots")
}

model RemediationEvent {
  id            String   @id @default(cuid())
  orgId         String   @map("org_id")
  controlCode   String   @map("control_code")
  frameworkName String   @map("framework_name")
  fromStatus    String   @map("from_status")
  toStatus      String   @default("has_evidence") @map("to_status")
  daysToFix     Int?     @map("days_to_fix")
  detectedAt    DateTime @default(now()) @map("detected_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, detectedAt])
  @@index([controlCode, frameworkName, detectedAt])
  @@map("remediation_events")
}

model EvidenceFeedback {
  id            String   @id @default(cuid())
  orgId         String   @map("org_id")
  controlCode   String   @map("control_code")
  frameworkName String   @map("framework_name")
  evidenceHash  String   @map("evidence_hash")
  rating        String   // "positive" | "negative"
  createdAt     DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, controlCode, frameworkName, evidenceHash])
  @@index([controlCode, frameworkName, evidenceHash])
  @@map("evidence_feedback")
}

// ============================================
// GITHUB WEBHOOKS
// ============================================

model WebhookEvent {
  id          String    @id @default(cuid())
  orgId       String    @map("org_id")
  repoId      String?   @map("repo_id")
  deliveryId  String    @unique @map("delivery_id")
  eventType   String    @map("event_type")
  action      String?
  payload     Json
  processedAt DateTime? @map("processed_at")
  error       String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, eventType, createdAt])
  @@map("webhook_events")
}

// ============================================
// ORG MEMBERSHIP EVENTS
// ============================================

model OrgMembershipEvent {
  id           String   @id @default(cuid())
  orgId        String   @map("org_id")
  githubLogin  String   @map("github_login")
  githubUserId Int      @map("github_user_id")
  action       String   // "added" | "removed" | "role_changed"
  role         String?
  previousRole String?  @map("previous_role")
  occurredAt   DateTime @map("occurred_at")
  createdAt    DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, occurredAt])
  @@map("org_membership_events")
}

// ============================================
// CI ARTIFACTS
// ============================================

model CIArtifact {
  id           String   @id @default(cuid())
  repoId       String   @map("repo_id")
  orgId        String   @map("org_id")
  runId        String   @map("run_id")
  name         String
  artifactType String   @map("artifact_type") // "sarif" | "sbom" | "test_report" | "coverage" | "unknown"
  summary      Json?
  rawUrl       String?  @map("raw_url")
  createdAt    DateTime @default(now()) @map("created_at")

  repository   Repository   @relation(fields: [repoId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([repoId, runId, artifactType])
  @@index([repoId, artifactType, createdAt])
  @@map("ci_artifacts")
}

// ============================================
// DEPLOYMENT ENVIRONMENTS
// ============================================

model DeploymentEnvironment {
  id                    String   @id @default(cuid())
  repoId                String   @map("repo_id")
  orgId                 String   @map("org_id")
  name                  String
  requireReviewers      Boolean  @default(false) @map("require_reviewers")
  reviewerCount         Int      @default(0) @map("reviewer_count")
  preventSelfReview     Boolean  @default(false) @map("prevent_self_review")
  requiredBranches      String[] @map("required_branches")
  deploymentBranchPolicy String? @map("deployment_branch_policy")
  syncedAt              DateTime @default(now()) @map("synced_at")

  repository   Repository   @relation(fields: [repoId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([repoId, name])
  @@index([repoId])
  @@map("deployment_environments")
}

// ============================================
// RISK TREATMENTS
// ============================================

model RiskTreatment {
  id              String    @id @default(cuid())
  orgId           String    @map("org_id")
  controlCode     String    @map("control_code")
  frameworkName   String    @map("framework_name")
  treatmentType   String    @map("treatment_type") // "remediate" | "accept" | "transfer" | "avoid"
  status          String    @default("open") // "open" | "in_progress" | "closed" | "overdue"
  rationale       String    @db.Text
  ownerId         String?   @map("owner_id")
  reviewDate      DateTime? @map("review_date")
  linkedGithubIssue String? @map("linked_github_issue")
  closedAt        DateTime? @map("closed_at")
  closedByEvidence String?  @map("closed_by_evidence")
  createdById     String    @map("created_by_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  owner        User?        @relation("TreatmentOwner", fields: [ownerId], references: [id])
  createdBy    User         @relation("TreatmentCreator", fields: [createdById], references: [id])

  @@unique([orgId, controlCode, frameworkName])
  @@index([orgId, status])
  @@map("risk_treatments")
}

// ============================================
// GAP ASSIGNMENTS
// ============================================

model GapAssignment {
  id            String    @id @default(cuid())
  orgId         String    @map("org_id")
  controlCode   String    @map("control_code")
  frameworkName  String    @map("framework_name")
  assigneeId    String    @map("assignee_id")
  assignedById  String    @map("assigned_by_id")
  dueDate       DateTime? @map("due_date")
  notes         String?   @db.Text
  status        String    @default("open") // "open" | "resolved" | "deferred"
  resolvedAt    DateTime? @map("resolved_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assignee     User         @relation("GapAssignee", fields: [assigneeId], references: [id])
  assignedBy   User         @relation("GapAssigner", fields: [assignedById], references: [id])

  @@unique([orgId, controlCode, frameworkName])
  @@index([orgId, status])
  @@index([assigneeId])
  @@map("gap_assignments")
}

// ============================================
// AUDIT CYCLES
// ============================================

model AuditCycle {
  id                 String    @id @default(cuid())
  orgId              String    @map("org_id")
  frameworkName      String    @map("framework_name")
  auditType          String    @map("audit_type") // "internal" | "external" | "certification"
  status             String    @default("planning") // "planning" | "fieldwork" | "reporting" | "closed"
  periodStart        DateTime  @map("period_start")
  periodEnd          DateTime  @map("period_end")
  auditorName        String?   @map("auditor_name")
  auditorFirm        String?   @map("auditor_firm")
  auditorSessionId   String?   @map("auditor_session_id")
  outcome            String?   // "passed" | "passed_with_findings" | "failed" | null
  targetCloseDate    DateTime? @map("target_close_date")
  closedAt           DateTime? @map("closed_at")
  evidenceSnapshotId String?   @map("evidence_snapshot_id")
  createdById        String    @map("created_by_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  organization Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy    User            @relation(fields: [createdById], references: [id])
  findings     AuditFinding[]
  requests     AuditorRequest[]

  @@index([orgId, status])
  @@map("audit_cycles")
}

model AuditFinding {
  id                     String    @id @default(cuid())
  auditCycleId           String    @map("audit_cycle_id")
  orgId                  String    @map("org_id")
  controlCode            String    @map("control_code")
  frameworkName          String    @map("framework_name")
  severity               String    // "critical" | "major" | "minor" | "observation"
  description            String    @db.Text
  auditorNotes           String?   @db.Text @map("auditor_notes")
  remediationCommitment  String?   @db.Text @map("remediation_commitment")
  remediationDueDate     DateTime? @map("remediation_due_date")
  status                 String    @default("open") // "open" | "remediated" | "accepted"
  createdAt              DateTime  @default(now()) @map("created_at")

  auditCycle   AuditCycle   @relation(fields: [auditCycleId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([auditCycleId])
  @@index([orgId, controlCode])
  @@map("audit_findings")
}

model AuditorRequest {
  id             String    @id @default(cuid())
  auditCycleId   String    @map("audit_cycle_id")
  orgId          String    @map("org_id")
  controlCode    String?   @map("control_code")
  frameworkName  String?   @map("framework_name")
  requestText    String    @db.Text @map("request_text")
  status         String    @default("open") // "open" | "in_progress" | "resolved" | "deferred"
  assigneeId     String?   @map("assignee_id")
  dueDate        DateTime? @map("due_date")
  resolvedAt     DateTime? @map("resolved_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  auditCycle   AuditCycle   @relation(fields: [auditCycleId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assignee     User?        @relation(fields: [assigneeId], references: [id])

  @@index([auditCycleId])
  @@index([orgId, status])
  @@map("auditor_requests")
}
