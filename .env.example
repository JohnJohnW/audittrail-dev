# =============================================================================
# Audit Trail — Environment Variables
# Copy this file to .env.local and fill in your values.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (required)
# Supabase → Settings → Database → Connection string (Transaction mode)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:[password]@[host]:5432/postgres"

# -----------------------------------------------------------------------------
# NextAuth (required)
# NEXTAUTH_URL  — your deployment URL (no trailing slash)
# NEXTAUTH_SECRET — run: openssl rand -base64 32
# -----------------------------------------------------------------------------
NEXTAUTH_URL="https://your-app.vercel.app"
NEXTAUTH_SECRET=""

# -----------------------------------------------------------------------------
# GitHub OAuth App (required)
# Create one at: https://github.com/settings/developers
# Callback URL: ${NEXTAUTH_URL}/api/auth/callback/github
# -----------------------------------------------------------------------------
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# Token Encryption (strongly recommended)
# AES-256-GCM key for encrypting GitHub OAuth tokens at rest.
# Generate with: openssl rand -hex 32
# Without this key tokens are stored in plaintext — set it before first deploy.
# -----------------------------------------------------------------------------
ENCRYPTION_KEY=""

# -----------------------------------------------------------------------------
# Stripe (optional — required for Pro subscriptions)
# STRIPE_SECRET_KEY       — from Stripe Dashboard → Developers → API keys
# STRIPE_PRO_PRICE_ID     — Price ID for the Pro plan (price_...)
# STRIPE_WEBHOOK_SECRET   — from Stripe Dashboard → Webhooks → signing secret
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_PRO_PRICE_ID=""
STRIPE_WEBHOOK_SECRET=""

# -----------------------------------------------------------------------------
# Resend — transactional email (optional)
# Required only if you want weekly digest emails.
# Create a key at: https://resend.com/api-keys
# EMAIL_FROM — must be a verified sender address in your Resend account
# -----------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="Audit Trail <noreply@yourdomain.com>"

# -----------------------------------------------------------------------------
# Upstash Redis — rate limiting & caching (optional but recommended)
# Create a database at: https://console.upstash.com
# If not set, rate limiting is silently skipped and caching is disabled.
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# -----------------------------------------------------------------------------
# Cron job secret (required for scheduled syncs on Vercel)
# Used by vercel.json cron → /api/cron/sync to authenticate the request.
# Generate with: openssl rand -hex 32
# Set the same value in Vercel Dashboard → Environment Variables.
# -----------------------------------------------------------------------------
CRON_SECRET=""

# -----------------------------------------------------------------------------
# Supabase Vector Store (required for Phase 2 embeddings)
# Project URL and service-role key (NOT the anon key).
# Settings → API → Project URL and Service Role Key.
# NEXT_PUBLIC_SUPABASE_URL is also used by the Prisma datasource.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# -----------------------------------------------------------------------------
# Google Gemini — Embedding 2 (required for Phase 2 multimodal embeddings)
# Create a key at: https://aistudio.google.com/app/apikey
# Model: gemini-embedding-2-preview (768-dimensional, multimodal)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=""

# -----------------------------------------------------------------------------
# Anthropic Claude — CISO executive summary (optional, Pro feature)
# Create a key at: https://console.anthropic.com/api-keys
# Used by /api/ciso/executive-summary to draft board narratives.
# Model: claude-sonnet-4-20250514
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=""

# -----------------------------------------------------------------------------
# GitHub App — webhook integration (optional, Phase 1 real-time events)
# Install your GitHub App on the org and set the webhook secret below.
# The webhook endpoint is: POST /api/webhooks/github
# GITHUB_WEBHOOK_SECRET — the secret you set when creating the GitHub App
# GITHUB_APP_INSTALLATION_ID — installation ID from the GitHub App settings
# -----------------------------------------------------------------------------
GITHUB_WEBHOOK_SECRET=""
GITHUB_APP_INSTALLATION_ID=""

# -----------------------------------------------------------------------------
# Flywheel — anonymized signal capture (optional, Phase 6)
# When enabled, records anonymized compliance signals for model improvement.
# No orgId or PII is stored in flywheel tables.
# -----------------------------------------------------------------------------
FLYWHEEL_ENABLED="false"
